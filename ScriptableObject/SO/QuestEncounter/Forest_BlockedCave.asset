    tierPenaltyPercent: 4
    difficultyPenaltyPercent: 6
    maxChancePercent: 35
    revealedText: "\uBC14\uC704 \uC544\uB798\uC5D0\uB294 \uBC00\uC5B4\uB0BC \uB9CC\uD55C
      \uD2C8\uC774 \uC788\uACE0 \uD45C\uBA74\uC5D0\uB294 \uAE08\uC774 \uAC00 \uC788\uC2B5\uB2C8\uB2E4.
      \uB3D9\uAD74 \uC548\uC5D0\uC11C \uC624\uB798\uB41C \uC7A5\uBE44 \uB0C4\uC0C8\uC640
